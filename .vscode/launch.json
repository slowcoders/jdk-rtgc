{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "RTGC(linux)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceRoot}/build/linux-x86_64-client-fastdebug/images/jdk/bin/java",
            "args": ["-cp", "test/rtgc", "Main", "2", "1000"],
            "stopAtEntry": false,
            "cwd": "${workspaceRoot}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "Build Main"
        },
        {
            "name": "RTGC(linux/jdk-lldb)",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceRoot}/build/linux-x86_64-client-fastdebug/jdk/bin/java",
            "args": ["-cp", "test/rtgc", "Main", "2", "1000"],
            "stopOnEntry": false,
            "cwd": "${workspaceRoot}",
            "breakpointMode": "file",
            // "preLaunchTask": "Build Main"
        },        
        {
            "name": "RTGC(mac)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceRoot}/build/macosx-x86_64-client-fastdebug/images/jdk/bin/java",
            "args": ["-cp", "test/rtgc", "Main", "2", "100000"],
            "stopAtEntry": false,
            "cwd": "${workspaceRoot}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "Build Main"
        }
    ]
}